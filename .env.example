# AutoQuickSetup 環境變數設定範例
# 請將此檔案複製一份並重命名為 .env，填入您個人的私密 key 或自訂配置。
# .env 已加入 .gitignore，絕對不會被 commit 或公開上傳至 GitHub。

# [反饋信箱] 自訂回報對象 Email
FEEDBACK_EMAIL=u9511112@gmail.com

# [API Key / Token] 若未來串接第三方 API（例：Gemini, OpenAI, Custom Webhook），在此設定：
# API_KEY=your_api_key_here
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# [自訂更新端點]（預設為官方 GitHub Release）
# UPDATE_URL=https://raw.githubusercontent.com/u9511112/AutoQuickSetup/master/version.json
# UPDATE_EXE_URL=https://github.com/u9511112/AutoQuickSetup/releases/latest/download/AutoQuickSetup.exe
